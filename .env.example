# Punchout configuration.
#
# Every variable the code actually reads is listed here, including the ones
# with no value to fill in, so this file can answer "what is configurable?"
# without grepping for process.env. It previously listed only the two PostHog
# keys — omitting both of the variables that decide whether the admin surface
# is reachable and where a pilot's data lives.

# ─── Operationally required in production ────────────────────────────────────

# Bearer token for every admin route (/api/relay, /api/day-trace,
# /api/operations-center, /api/runtime/*, /api/export GET, /api/devices/*).
#
# Fails CLOSED when unset: no token is registered, so every admin request is
# rejected with 401. That is the safe direction, but it also means an operator
# who forgets this cannot reach the Relay or the Day Trace during an incident.
PUNCHOUT_ADMIN_TOKEN=

# Absolute path to the directory holding backend state and the Relay archive.
#
# The process REFUSES TO START in production without it (see
# lib/backend/persistence.mjs). Local dev and tests fall back to `.data`, which
# is why this can be left blank here but must be set on a real deployment: the
# fallback lives inside the deployment directory, so a redeploy would take the
# pilot's workdays with it.
PUNCHOUT_DATA_DIR=

# ─── Optional ────────────────────────────────────────────────────────────────

# Where crash telemetry is forwarded. Unset means crash reports are stored
# locally and never forwarded — not that they are discarded.
PUNCHOUT_CRASH_WEBHOOK_URL=

# Port for the standalone server (`node server.js`). Defaults to 3000.
PORT=

# ─── Client-visible (NEXT_PUBLIC_*, shipped to the browser) ──────────────────
# Never put a secret behind a NEXT_PUBLIC_ name: these are inlined into the
# client bundle at build time and readable by anyone loading the page.

# PostHog client telemetry (configure in Vercel Preview/Production).
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=

# Release provenance shown in-app, so a field report can name the exact build.
NEXT_PUBLIC_RELEASE_SHA=
NEXT_PUBLIC_DEPLOYMENT_ENV=
