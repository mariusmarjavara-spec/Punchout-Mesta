      "trigger": { "event": "factObserved", "factKey": "incidentReported" },
      "conditions": [{ "field": "incidentReported", "operator": "equals", "value": true }],
      "action": { "type": "requireSchema", "target": "avvik" },
      "priority": 100,
      "affects": { "schemaTypes": ["avvik"] }
